@model System.Collections.Generic.List<Dpz.Core.Public.ViewModel.Response.ArticleSearchResultResponse>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<style>
    .article-abstract img {
        max-width: 100%;
    }
</style>
<div class="blog-container">
    <blockquote class="layui-elem-quote sitemap layui-breadcrumb shadow">
        <a href="/" title="网站首页">网站首页</a>
        <a>
            <cite>文章搜索
                <mark>@ViewData["keyword"]</mark>
            </cite>
        </a>
    </blockquote>
    <div class="blog-main">
        <div class="blog-main-left">
            @if (Model.Count == 0)
            {
                <div class="shadow search-empty">
                    未搜索到与【<span class="search-keyword">@ViewData["keyword"]</span>】有关的文章，随便看看吧！
                </div>
            }
            @foreach (var item in Model)
            {
                <div class="article shadow layui-anim layui-anim-upbit">

                    <div class="article-right" style="width:100%">
                        <div class="article-title">
                            <a
                                asp-action="Read"
                                asp-controller="Article"
                                asp-route-id="@item.Id"
                                asp-route-text="@ViewData["keyword"]"
                                data-pjax>
                                @Html.Raw(item.HighlightTitle())
                            </a>
                        </div>
                        <div class="article-abstract">
                            <div class="markdown-body">
                                @Html.Raw(item.HighlightContent().MarkdownToHtml(disableHtml: false))
                            </div>
                        </div>
                    </div>


                    <div class="clear"></div>
                    <div class="article-footer">
                        <span>
                            <i class="fa fa-clock-o"></i>
                            <time class="timeago" datetime="@item.CreateTime">@item.CreateTime</time>
                        </span>
                        <span class="article-author"><i class="fa fa-user"></i>&nbsp;&nbsp;@item.Author.Name</span>
                        @foreach (var tag in item.Tags)
                        {
                            <span><i class="fa fa-tag"></i>&nbsp;&nbsp;
                                <a asp-action="Index" asp-controller="Article" asp-route-tag="@tag" data-pjax>@tag</a>
                            </span>
                        }
                        <span class="article-viewinfo"><i class="fa fa-eye"></i>&nbsp;@item.ViewCount</span>
                        <span class="article-viewinfo"><i class="fa fa-commenting"></i>&nbsp;@item.CommentCount</span>
                    </div>
                </div>
            }
        </div>
        <div class="blog-main-right">
            <div class="blog-search">
                <form class="layui-form" asp-action="Search" method="get">
                    <div class="layui-form-item">
                        <div class="search-keywords  shadow">
                            <input type="text" name="keyword" lay-verify="required" placeholder="输入关键词搜索"
                                   autocomplete="off" value="@ViewData["keyword"]" class="layui-input">
                        </div>
                        <div class="search-submit  shadow">
                            <button class="search-btn" lay-submit="formSearch" lay-filter="formSearch">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="blog-module shadow" data-request="@Url.Action("TodayNews", "Home")">
                <img src="@Program.CdnBaseAddress/loaders/bars.svg" alt="loading" style="width: 100%"/>
            </div>
        </div>
        <div class="clear"></div>
    </div>
</div>