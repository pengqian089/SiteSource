@model Tuple<IList<VmArticleMini>,IList<VmArticleMini>,IList<string>>
@{
    var tag = Context.Request.Query["tag"];
}
<div class="right-category-nav-v2 shadow">
    <div class="right-category-title-v2">分类导航</div>
    <div class="right-category-tags-v2">
        @foreach (var item in Model.Item3)
        {
            if (tag == item)
            {
                <a asp-controller="Article" asp-action="Index" asp-route-tag="@item" class="right-category-tag-v2 right-category-tag-active-v2">@item</a>
            }
            else
            {
                <a asp-controller="Article" asp-action="Index" asp-route-tag="@item" class="right-category-tag-v2">@item</a>
            }
        }
    </div>
</div>
<div class="right-module-v2 shadow">
    <div class="right-module-title-v2">或许你会喜欢</div>
    <ul class="right-module-list-v2">
        @foreach (var item in Model.Item1)
        {
            <li class="right-module-item-v2">
                <i class="right-module-icon-v2 fa fa-hand-o-right"></i>
                <a asp-action="Read" asp-controller="Article" asp-route-id="@item.Id" data-pjax class="right-module-link-v2">@item.Title</a>
            </li>
        }
    </ul>
</div>
<div class="right-module-v2 shadow">
    <div class="right-module-title-v2">最近文章</div>
    <ul class="right-module-list-v2">
        @foreach (var item in Model.Item2)
        {
            <li class="right-module-item-v2">
                <i class="right-module-icon-v2 fa fa-hand-o-right"></i>
                <a asp-action="Read" asp-controller="Article" asp-route-id="@item.Id" data-pjax class="right-module-link-v2">@item.Title</a>
            </li>
        }
    </ul>
</div>

<!--移动端遮罩层-->
<div class="right-category-mask-v2"></div>

<!--右边悬浮 平板或手机设备显示-->
<div class="right-category-toggle-v2"><i class="fa fa-chevron-left"></i></div>