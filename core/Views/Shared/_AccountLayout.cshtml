@using Dpz.Core.EnumLibrary
@using Dpz.Core.Web.Library
@using Microsoft.Extensions.Configuration
@inject IConfiguration _configuration
@{
    Layout = "_Layout";
    var user = await Context.GetUserInfo();
}
<style>
    .layui-form.layui-card-header.account-search {
        padding-top: 15px;
        padding-bottom: 15px;
        height: auto;
    }
    table a{color:#bb0662}
</style>
<div class="layui-container fly-marginTop fly-user-main">
    <ul class="layui-nav layui-nav-tree layui-inline" lay-filter="user" style="z-index: 0">
        <li class="layui-nav-item @(ViewBag.AccountMenu == AccountMenu.Setting ? "layui-this" : "")">
            <a asp-action="Index" asp-controller="Account">
                <i class="layui-icon">&#xe620;</i>
                基本设置
            </a>
        </li>
        <li class="layui-nav-item @(ViewBag.AccountMenu == AccountMenu.Article ? "layui-this" : "")">
            <a asp-action="MyArticle" asp-controller="Account">
                <i class="layui-icon">&#xe60a;</i>
                我的文章
            </a>
        </li>
        <li class="layui-nav-item @(ViewBag.AccountMenu == AccountMenu.Talk ? "layui-this" : "")">
            <a asp-action="MyTalk" asp-controller="Account">
                <i class="layui-icon">&#xe63a;</i>
                碎碎念
            </a>
        </li>
        <li class="layui-nav-item @(ViewBag.AccountMenu == AccountMenu.Timeline ? "layui-this" : "")">
            <a asp-action="MyTimeline" asp-controller="Account">
                <i class="layui-icon">&#xe609;</i>
                时间轴
            </a>
        </li>
        <li class="layui-nav-item @(ViewBag.AccountMenu == AccountMenu.MusicLibrary ? "layui-this" : "")">
            <a asp-action="MusicLibrary" asp-controller="Account">
                <i class="layui-icon">&#xe688;</i>
                曲库
            </a>
        </li>
    </ul>
    <div class="fly-panel fly-panel-user" pad20>
        <div class="layui-tab layui-tab-brief" lay-filter="user-panel">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts{
    <link href="@(_configuration["CDNBaseAddress"])/lib/gridmanager/css/gm.css" rel="stylesheet"/>
    <script src="@(_configuration["CDNBaseAddress"])/js/dayjs.min.js"></script>
    <script src="@(_configuration["CDNBaseAddress"])/lib/gridmanager/js/gm.js"></script>
    <environment include="Development">
        <script src="@(_configuration["CustomScript"])/account.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="@(_configuration["CustomScript"])/account.min.js?version=1.0.0" asp-append-version="true"></script>
    </environment>
    @await RenderSectionAsync("endScripts", required: false)
}