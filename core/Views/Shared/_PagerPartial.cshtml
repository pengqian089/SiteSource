@addTagHelper *, Dpz.Core.Web.Pager
@model PageModel

@{
    var maxPage = Model.MaxPage ?? 0;
}
@if (maxPage > 0 && Model.List.CurrentPageIndex == maxPage)
{
    <div>需要查看更多文章？请根据标签筛选，更早的文章原则上不显示</div>
}
<device exclude="mobile">
    <div>
        <div style="text-align: center;" id="@Model.HtmlTagIdAttribute">
            <pager
                page-index-parameter-name="pageIndex"
                show-first-last="false"
                tag-name="div"
                class="laypage-main"
                current-pager-item-template="<span class='laypage-curr'>{0}</span>"
                disabled-pager-item-template="<a>{0}</a>"
                pager-item-template="{0}"
                next-page-text="下一页"
                prev-page-text="上一页"
                id="pager"
                maximum-page-number="maxPage"
                show-more-pager-items="false"
                numeric-pager-item-count="5"
                asp-model="@Model.List">
            </pager>
        </div>
    </div>
</device>

<device include="mobile">
    <div>
        <div style="text-align: center;" id="@Model.HtmlTagIdAttribute">
            <pager
                page-index-parameter-name="pageIndex"
                show-first-last="false"
                tag-name="div"
                class="laypage-main"
                current-pager-item-template="<span class='laypage-curr'>{0}</span>"
                disabled-pager-item-template="<a>{0}</a>"
                pager-item-template="{0}"
                next-page-text="下一页"
                prev-page-text="上一页"
                id="pager"
                maximum-page-number="maxPage"
                show-more-pager-items="false"
                numeric-pager-item-count="3"
                show-prev-next="true"
                asp-model="@Model.List">
            </pager>
        </div>
    </div>
</device>