@using Microsoft.Extensions.Configuration
@inject IConfiguration _configuration 
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <title>用户登录</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="@(_configuration["CDNBaseAddress"])/vendor/bootstrap/css/bootstrap.min.css">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="@(_configuration["CDNBaseAddress"])/fonts/font-awesome-4.7.0/css/font-awesome.min.css">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="@(_configuration["CDNBaseAddress"])/vendor/animate/animate.css">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="@(_configuration["CDNBaseAddress"])/vendor/css-hamburgers/hamburgers.min.css">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="@(_configuration["CDNBaseAddress"])/vendor/select2/select2.min.css">
    <!--===============================================================================================-->
    <link rel="stylesheet" type="text/css" href="@(_configuration["CDNBaseAddress"])/css/util.css">
    <link rel="stylesheet" type="text/css" href="@(_configuration["CDNBaseAddress"])/css/login.css">
    <!--===============================================================================================-->
</head>
<body>
    <div class="limiter">
        <div class="container-login100">
            <div class="wrap-login100">
                <div class="login100-pic js-tilt" data-tilt>
                    <img src="@(_configuration["CDNBaseAddress"])/images/img-01.png" alt="IMG">
                </div>

                <form class="login100-form validate-form" method="post" asp-action="Login" asp-controller="Account">
                    <span class="login100-form-title">
                        会员登录
                    </span>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="fromUrl" value="@Model" />
                    <div class="wrap-input100 validate-input" data-validate="请输入账号！">
                        <input class="input100" type="text" name="account" placeholder="账号">
                        <span class="focus-input100"></span>
                        <span class="symbol-input100">
                            <i class="fa fa-envelope" aria-hidden="true"></i>
                        </span>
                    </div>

                    <div class="wrap-input100 validate-input" data-validate="请输入密码！">
                        <input class="input100" type="password" name="password" placeholder="密码">
                        <span class="focus-input100"></span>
                        <span class="symbol-input100">
                            <i class="fa fa-lock" aria-hidden="true"></i>
                        </span>
                    </div>
                    
                    <div class="wrap-input100">
                        <input class="input100" type="text" pattern="\d+" name="pinCode" placeholder="PIN码" maxlength="6">
                        <span class="focus-input100"></span>
                        <span class="symbol-input100">
                            <i class="fa fa-code" aria-hidden="true"></i>
                        </span>
                    </div>
                    
                    <div class="contact100-form-checkbox">
                        <input class="input-checkbox100" id="ckb1" type="checkbox" name="remember" value="true">
                        <label class="label-checkbox100" for="ckb1">
                            记住我
                        </label>
                    </div>
                    <div class="wrap-input100 validate-input">
                        
                        @if (TempData["Msg"] != null)
                        {
                            <div>
                                <span style="color:red">@TempData["Msg"]</span>
                            </div>
                        }
                    </div>
                    <div class="container-login100-form-btn">
                        @* <input type="hidden" name="scene" value="@((int)CaptchaScene.Login)"> *@
                        @* <input type="hidden" name="ticket" value=""> *@
                        @* <input type="hidden" name="randStr" value=""> *@
                        <button class="login100-form-btn">登录</button>
                    </div>

                    <div class="text-center p-t-12">
                        <span class="txt1">
                            忘记
                        </span>
                        <a class="txt2" href="#">
                            账号 / 密码?
                        </a>
                    </div>

                    <div class="text-center p-t-60">
                        <a class="txt2" href="#">
                            创建你的账号
                            <i class="fa fa-long-arrow-right m-l-5" aria-hidden="true"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!--===============================================================================================-->
    <script src="@(_configuration["CDNBaseAddress"])/lib/jquery/jquery.min.js"></script>
    <!--===============================================================================================-->
    <script src="@(_configuration["CDNBaseAddress"])/vendor/bootstrap/js/popper.js"></script>
    <script src="@(_configuration["CDNBaseAddress"])/vendor/bootstrap/js/bootstrap.min.js"></script>
    <!--===============================================================================================-->
    <script src="@(_configuration["CDNBaseAddress"])/vendor/select2/select2.min.js"></script>
    <!--===============================================================================================-->
    <script src="@(_configuration["CDNBaseAddress"])/vendor/tilt/tilt.jquery.min.js"></script>
    <!--===============================================================================================-->
    @* <script src="https://ssl.captcha.qq.com/TCaptcha.js"></script> *@
    <script src="@(_configuration["CDNBaseAddress"])/js/login.js"></script>

</body>
</html>
