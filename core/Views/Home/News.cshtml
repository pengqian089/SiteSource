@model TodayNewsModel?

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <title>today news</title>
</head>
<body>
<div>
    @if (Model?.NewsList != null)
    {
        foreach (var item in Model.NewsList)
        {
            <div>@(Model.NewsList.IndexOf(item) + 1). @item.Title</div>
        }
    }
</div>
</body>
</html>