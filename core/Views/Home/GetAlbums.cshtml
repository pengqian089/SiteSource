@using System.Text.Json
@model IPagedList<VmPictureRecord>

<div class="albums-container-v2">
    <div class="albums-header-v2">
        <div class="albums-title-v2">
            <h1 class="ds-text-heading">📸 相册</h1>
            <p class="ds-text-body">发现美好瞬间，分享生活点滴</p>
        </div>
        <div class="albums-stats-v2">
            <div class="albums-stat-item-v2">
                <span class="albums-stat-number-v2" id="totalCount">@Model.TotalItemCount</span>
                <span class="albums-stat-label-v2">张照片</span>
            </div>
            <div class="albums-stat-item-v2">
                <span class="albums-stat-number-v2" id="currentPage">@Model.CurrentPageIndex</span>
                <span class="albums-stat-label-v2">/ @Model.TotalPageCount 页</span>
            </div>
        </div>
    </div>

    <div class="albums-masonry-v2" id="albumsMasonry">
        @foreach (var picture in Model)
        {
            <div class="albums-picture-card-v2" data-id="@picture.Id">
                <div class="albums-picture-wrapper-v2">
                    <img 
                        src="@picture.AccessUrl!albums" 
                        alt="@picture.Description" 
                        class="albums-picture-image-v2"
                        data-width="@picture.Width"
                        data-height="@picture.Height"
                        loading="lazy"
                    />
                    <div class="albums-picture-overlay-v2">
                        <div class="albums-picture-actions-v2">
                            <button class="albums-action-btn-v2 albums-view-btn" data-id="@picture.Id" data-url="@picture.AccessUrl">
                                <i class="fa fa-eye"></i>
                            </button>
                            <button class="albums-action-btn-v2 albums-download-btn" data-url="@picture.AccessUrl" data-id="@picture.Id">
                                <i class="fa fa-download"></i>
                            </button>
                            <button class="albums-action-btn-v2 albums-share-btn" data-url="@picture.AccessUrl" data-description="@picture.Description">
                                <i class="fa fa-share"></i>
                            </button>
                        </div>
                    </div>
                </div>
                
                <div class="albums-picture-info-v2">
                    @if (!string.IsNullOrEmpty(picture.Description))
                    {
                        <div class="albums-picture-description-v2">
                            <p class="ds-text-body">@picture.Description</p>
                        </div>
                    }
                    
                    @if (picture.Tags != null && picture.Tags.Any())
                    {
                        <div class="albums-picture-tags-v2">
                            @foreach (var tag in picture.Tags)
                            {
                                <span class="ds-badge ds-badge-primary albums-tag-v2">#@tag</span>
                            }
                        </div>
                    }
                    
                    <div class="albums-picture-meta-v2">
                        <div class="albums-picture-user-v2">
                            <img 
                                src="@(!string.IsNullOrEmpty(picture.Creator.Avatar) ? picture.Creator.Avatar : "/core/images/default-avatar.png")" 
                                alt="@picture.Creator.Name" 
                                class="albums-user-avatar-v2"
                            />
                            <div class="albums-user-info-v2">
                                <span class="albums-user-name-v2">@picture.Creator.Name</span>
                                <span class="albums-upload-time-v2">@picture.UploadTime.ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                        </div>
                        <div class="albums-picture-size-v2">
                            <span class="ds-text-caption">@picture.Width × @picture.Height</span>
                            <span class="ds-text-caption">@((picture.Length / 1024.0 / 1024.0).ToString("F2")) MB</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- 加载更多指示器 -->
    <div class="albums-loading-v2" id="albumsLoading" style="display: none;">
        <div class="albums-loading-spinner-v2">
            <div class="ds-progress">
                <div class="ds-progress-bar" style="width: 100%; animation: ds-progress-shine 2s ease-in-out infinite;"></div>
            </div>
        </div>
        <p class="ds-text-body">正在加载更多图片...</p>
    </div>

    <!-- 无更多内容提示 -->
    <div class="albums-no-more-v2" id="albumsNoMore" style="display: none;">
        <div class="albums-no-more-icon-v2">
            <i class="fa fa-image"></i>
        </div>
        <p class="ds-text-body">没有更多图片了</p>
    </div>

    <!-- 空状态 -->
    @if (!Model.Any())
    {
        <div class="albums-empty-v2">
            <div class="albums-empty-icon-v2">
                <i class="fa fa-image"></i>
            </div>
            <h3 class="ds-text-heading">暂无图片</h3>
            <p class="ds-text-body">还没有上传任何图片，快来分享你的美好时光吧！</p>
        </div>
    }
</div>

<!-- 图片预览弹窗 -->
<div class="albums-modal-v2" id="albumsModal" style="display: none;">
    <div class="albums-modal-backdrop-v2"></div>
    <div class="albums-modal-content-v2">
        <button class="albums-modal-close-v2">
            <i class="fa fa-times"></i>
        </button>
        <div class="albums-modal-image-container-v2">
            <img id="albumsModalImage" src="" alt="" class="albums-modal-image-v2" />
            <div class="albums-modal-loading-v2" id="albumsModalLoading">
                <div class="albums-modal-loading-spinner-v2"></div>
                <span>加载中...</span>
            </div>
        </div>
        <div class="albums-modal-nav-v2">
            <button class="albums-modal-nav-btn-v2" id="albumsModalPrev">
                <i class="fa fa-chevron-left"></i>
            </button>
            <button class="albums-modal-nav-btn-v2" id="albumsModalNext">
                <i class="fa fa-chevron-right"></i>
            </button>
        </div>
        <div class="albums-modal-keyboard-hint-v2">
            <span>← → 切换图片 • 滚轮缩放 • 双击重置 • ESC 关闭</span>
        </div>
    </div>
</div>

<script>
// 初始化相册数据
window.albumsData = {
    currentPage: @Model.CurrentPageIndex,
    pageSize: @Model.PageSize,
    totalPages: @Model.TotalPageCount,
    totalCount: @Model.TotalItemCount,
    hasNextPage: @((Model.TotalPageCount > Model.CurrentPageIndex).ToString().ToLower()),
    pictures: @Html.Raw(JsonSerializer.Serialize(Model.Select(p => new { 
        id = p.Id, 
        url = p.AccessUrl, 
        description = p.Description,
        width = p.Width,
        height = p.Height
    })))
};
</script>