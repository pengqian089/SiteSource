@using Dpz.Core.Web.Library
@model VmCommenter

@if (Model is VmMemberCommenter membleCommenter)
{
    <span class="head-nickname">@Model.NickName</span><span class="identity">@membleCommenter.Identity</span>
}
else if(Model is VmGuestCommenter guestCommenter)
{
    if (!string.IsNullOrEmpty(guestCommenter.Site))
    {
        <a target="_blank" class="head-nickname" href="@guestCommenter.Site.ForceHttps()">@Model.NickName</a>
    }
    else
    {
        <span class="head-nickname">@Model.NickName</span>
    }
}