@using System.Net
@model CommentPage

<div class="comment-block">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form class="comment-form" asp-action="Send" autocomplete="off">
            <div class="comment-panel">
                <textarea 
                    required 
                    class="comment-form-editor" 
                    placeholder="支持markdown语法&#10;理论上不会暴露你的邮箱地址&#10;😁&#10;使用CommonMark 规范，该规范如需了解更多，请点击左下角Markdown图标。&#10;在此基础上，扩展了自动识别链接地址、额外强调语法、高亮代码语言，并禁用了HTML标签等功能。" 
                    name="commentText" 
                    maxlength="1000">
                </textarea>
                <div class="comment-form-footer">
                    <div class="form-footer-action">
                        <a href="https://spec.commonmark.org/" title="CommonMark 规范" class="footer-action-item" target="_blank">
                            <svg width="16" height="16" aria-hidden="true">
                                <path d="M14.85 3H1.15C.52 3 0 3.52 0 4.15v7.69C0 12.48.52 13 1.15 13h13.69c.64 0 1.15-.52 1.15-1.15v-7.7C16 3.52 15.48 3 14.85 3zM9 11H7V8L5.5 9.92 4 8v3H2V5h2l1.5 2L7 5h2v6zm2.99.5L9.5 8H11V5h2v3h1.5l-2.51 3.5z" fill="currentColor"></path>
                            </svg>
                        </a>
                        <label class="footer-action-item" data-image="" title="添加图片&#10;只提供网络图片&#10;不提供上传">
                            <svg viewBox="0 0 1024 1024" width="18" height="18">
                                <path d="M784 112H240c-88 0-160 72-160 160v480c0 88 72 160 160 160h544c88 0 160-72 160-160V272c0-88-72-160-160-160zm96 640c0 52.8-43.2 96-96 96H240c-52.8 0-96-43.2-96-96V272c0-52.8 43.2-96 96-96h544c52.8 0 96 43.2 96 96v480z" fill="currentColor"></path><path d="M352 480c52.8 0 96-43.2 96-96s-43.2-96-96-96-96 43.2-96 96 43.2 96 96 96zm0-128c17.6 0 32 14.4 32 32s-14.4 32-32 32-32-14.4-32-32 14.4-32 32-32zm462.4 379.2-3.2-3.2-177.6-177.6c-25.6-25.6-65.6-25.6-91.2 0l-80 80-36.8-36.8c-25.6-25.6-65.6-25.6-91.2 0L200 728c-4.8 6.4-8 14.4-8 24 0 17.6 14.4 32 32 32 9.6 0 16-3.2 22.4-9.6L380.8 640l134.4 134.4c6.4 6.4 14.4 9.6 24 9.6 17.6 0 32-14.4 32-32 0-9.6-4.8-17.6-9.6-24l-52.8-52.8 80-80L769.6 776c6.4 4.8 12.8 8 20.8 8 17.6 0 32-14.4 32-32 0-8-3.2-16-8-20.8z" fill="currentColor"></path>
                            </svg>
                        </label>
                    </div>
                    <div class="form-footer-btn">
                        <button type="submit" class="ds-button ds-button-primary">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="22" y1="2" x2="11" y2="13"></line>
                                <polygon points="22,2 15,22 11,13 2,9 22,2"></polygon>
                            </svg>
                            发送
                        </button>
                        <button type="submit" disabled style="display: none" aria-hidden="true"></button>
                    </div>
                </div>
            </div>
            <input type="hidden" value="@ViewData["relation"]" name="relation"/>
            <input type="hidden" value="@ViewData["node"]" name="node"/>
            <input type="hidden" value="" name="replyId"/>
        </form>
    }
    else
    {
        var nickname = WebUtility.UrlDecode(Context.Request.Cookies["nickname"] ?? "");
        var email = WebUtility.UrlDecode(Context.Request.Cookies["email"] ?? "");
        var site = WebUtility.UrlDecode(Context.Request.Cookies["site"] ?? "");
        <form class="comment-form" asp-action="Publish" autocomplete="off">
            <div class="comment-panel">
                <div class="comment-form-head">
                    <div class="form-head-item">
                        <label>昵称<span>*</span></label>
                        <input name="nickname" autocomplete="off" class="form-input" required value="@nickname" placeholder="请输入昵称"/>
                    </div>
                    <div class="form-head-item">
                        <label>邮箱<span>*</span></label>
                        <input name="email" type="email" autocomplete="off" class="form-input" required value="@email" placeholder="请输入邮箱"/>
                    </div>
                    <div class="form-head-item">
                        <label>网站</label>
                        <input name="site" type="url" autocomplete="off" class="form-input" value="@site" placeholder="请输入个人网站"/>
                    </div>
                    <button class="comment-btn-close" type="button" title="取消回复" style="display: none">
                        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
                <textarea 
                    required 
                    class="comment-form-editor"
                    placeholder="支持markdown语法&#10;理论上不会暴露你的邮箱地址&#10;😁&#10;使用CommonMark 规范，该规范如需了解更多，请点击左下角Markdown图标。&#10;在此基础上，扩展了自动识别链接地址、额外强调语法、高亮代码语言，并禁用了HTML标签等功能。" 
                    name="commentText" 
                    maxlength="1000">
                </textarea>
                <div class="comment-form-footer">
                    <div class="form-footer-action">
                        <a href="https://spec.commonmark.org/" title="CommonMark 规范" class="footer-action-item" target="_blank">
                            <svg width="16" height="16" aria-hidden="true">
                                <path d="M14.85 3H1.15C.52 3 0 3.52 0 4.15v7.69C0 12.48.52 13 1.15 13h13.69c.64 0 1.15-.52 1.15-1.15v-7.7C16 3.52 15.48 3 14.85 3zM9 11H7V8L5.5 9.92 4 8v3H2V5h2l1.5 2L7 5h2v6zm2.99.5L9.5 8H11V5h2v3h1.5l-2.51 3.5z" fill="currentColor"></path>
                            </svg>
                        </a>
                        <label class="footer-action-item" data-image="" title="添加图片&#10;只提供网络图片&#10;不提供上传">
                            <svg viewBox="0 0 1024 1024" width="18" height="18">
                                <path d="M784 112H240c-88 0-160 72-160 160v480c0 88 72 160 160 160h544c88 0 160-72 160-160V272c0-88-72-160-160-160zm96 640c0 52.8-43.2 96-96 96H240c-52.8 0-96-43.2-96-96V272c0-52.8 43.2-96 96-96h544c52.8 0 96 43.2 96 96v480z" fill="currentColor"></path><path d="M352 480c52.8 0 96-43.2 96-96s-43.2-96-96-96-96 43.2-96 96 43.2 96 96 96zm0-128c17.6 0 32 14.4 32 32s-14.4 32-32 32-32-14.4-32-32 14.4-32 32-32zm462.4 379.2-3.2-3.2-177.6-177.6c-25.6-25.6-65.6-25.6-91.2 0l-80 80-36.8-36.8c-25.6-25.6-65.6-25.6-91.2 0L200 728c-4.8 6.4-8 14.4-8 24 0 17.6 14.4 32 32 32 9.6 0 16-3.2 22.4-9.6L380.8 640l134.4 134.4c6.4 6.4 14.4 9.6 24 9.6 17.6 0 32-14.4 32-32 0-9.6-4.8-17.6-9.6-24l-52.8-52.8 80-80L769.6 776c6.4 4.8 12.8 8 20.8 8 17.6 0 32-14.4 32-32 0-8-3.2-16-8-20.8z" fill="currentColor"></path>
                            </svg>
                        </label>
                    </div>
                    <div class="form-footer-btn">
                        <button type="submit" class="ds-button ds-button-primary">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="22" y1="2" x2="11" y2="13"></line>
                                <polygon points="22,2 15,22 11,13 2,9 22,2"></polygon>
                            </svg>
                            发送
                        </button>
                        <button type="submit" disabled style="display: none" aria-hidden="true"></button>
                    </div>
                </div>
            </div>
            <input type="hidden" value="@ViewData["relation"]" name="relation"/>
            <input type="hidden" value="@ViewData["node"]" name="node"/>
            <input type="hidden" value="" name="replyId"/>
        </form>
    }
    
    <div class="comment-count">
        <span>@Model?.Count</span>
        评论
        <button class="refresh" title="刷新评论" data-refresh="@Url.Action("Page", new {node = ViewData["node"], relation = ViewData["relation"]})">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="23,4 23,10 17,10"></polyline>
                <polyline points="1,20 1,14 7,14"></polyline>
                <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
            </svg>
        </button>
    </div>
    
    <div class="comments-area">
        <partial name="_CommentListPartial_v2" model="Model"/>
    </div>
</div> 