@using Microsoft.AspNetCore.Mvc.TagHelpers
@model BookmarkModel

<div class="bookmark">
    <div class="search-box">
        <input type="search" id="search-bookmark" title="搜索书签" placeholder="搜索书签" value="@Model.Title" autocomplete="off"/>
        <div class="search-result" style="display: none">
            <ul>

            </ul>
        </div>
    </div>
    <partial name="_ShowCategoriesPartial" model="(Model.Categories,Model.SelectedCategories)"/>
    @if (User.IsAdmin())
    {
        <partial name="Create" model="null"/>    
    }
    <div class="bookmark-container">
        <partial name="_BookmarksPartial" model="Model.Bookmarks"/>
    </div>
</div>